# =============================================================================
# TABLE 1 CODE 
# =============================================================================

table_1 <- subset_3pad %>%
  transmute(
    pid,
    age = gb1_age,
    bmi,

    education = factor(if_else(edu == "University", "University", "Lower")),
    country   = factor(if_else(country == "Sweden", "Sweden", "Other")),

    # Binary variables (CLEAN YES/NO STANDARD)
    Medication = factor(if_else(meds == 1, "Yes", "No")),
    SSRI       = factor(if_else(SSRI == "Yes", "Yes", "No")),
    PCOS       = factor(if_else(pcos == "Yes", "Yes", "No")),

    # T1 outcomes
    EPDS_T1 = gb1_epds_sum,
    GAD7_T1 = gb1_gad7_sum,

    parity_T1 = factor(if_else(gb1_first_preg == 1, "Nulliparous", "Multiparous")),
    anemia_T1 = factor(if_else(gb1_anemia == 1, "Anemic", "Not anemic")),

    gest_week_T1 = as.numeric(gb1_preg_week),

    relationship_status_T1 = factor(if_else(gb1_relationship == 1, "Yes", "No")),

    exercise_T1 = factor(if_else(exercise1 == "Moderate to high",
                                 "Moderate to high", "Low to none")),

    pos_LE1 = factor(if_else(pos_LE1 == "Yes", "Yes", "No")),
    neg_LE1 = factor(if_else(neg_LE1 == "Yes", "Yes", "No")),

    # T2 outcomes
    EPDS_T2 = gb2_epds_sum,
    GAD7_T2 = gb2_gad7_sum,

    parity_T2 = factor(if_else(gb2_first_preg == 1, "Nulliparous", "Multiparous")),
    Anemia_T2 = factor(if_else(gb2_anemia == 1, "Anemic", "Not anemic")),

    gest_week_T2 = as.numeric(gb2_preg_week),

    neg_LE2 = factor(if_else(neg_LE2 == "Yes", "Yes", "No")),
    pos_LE2 = factor(if_else(pos_LE2 == "Yes", "Yes", "No"))
  )

table_1 <- table_1 %>%
  mutate(
    Parity = factor(if_else(
      is.na(parity_T1),
      as.character(parity_T2),
      as.character(parity_T1)
    ))
  ) %>%
  dplyr::select(-parity_T1, -parity_T2)

table_1 <- table_1 %>%
  mutate(
    GAD_high_T1  = factor(if_else(GAD7_T1  >= 7,  "High", "Low")),
    EPDS_high_T1 = factor(if_else(EPDS_T1 >= 10, "High", "Low")),
    GAD_high_T2  = factor(if_else(GAD7_T2  >= 7,  "High", "Low")),
    EPDS_high_T2 = factor(if_else(EPDS_T2 >= 10, "High", "Low"))
  )

table_1_T1 <- table_1 %>% 
  dplyr::select(-EPDS_high_T2, -GAD_high_T2, -Anemia_T2, -neg_LE2, -pos_LE2, -gest_week_T2)

table_1_T2 <- table_1 %>% 
  dplyr::select(pid, EPDS_high_T2, GAD_high_T2, Anemia_T2, neg_LE2, pos_LE2, gest_week_T2, EPDS_T2, GAD7_T2)


t1_epds <- table_1_T1 %>%
  dplyr::select(-pid, -GAD_high_T1) %>%

  tbl_summary(
    by = EPDS_high_T1,
    type = c(gest_week_T1, bmi, EPDS_T1, EPDS_T2, GAD7_T1, GAD7_T2, age) ~ "continuous",
    missing = "ifany",
    missing_text = "Missing",
    sort = all_categorical() ~ "frequency",
    statistic = all_continuous() ~ "{mean} ({sd})",
    digits = all_categorical() ~ 1,
    label = list(
      relationship_status_T1 ~ "In a relationship",
      exercise_T1 ~ "Exercise level",
      anemia_T1 ~ "Self-reported anemia (T1)",
      country ~ "Country of birth",
      age ~ "Maternal age",
      gest_week_T1 ~ "Gestational week (T1)",
      education ~ "Educational attainment",
      pos_LE1 ~ "Recent positive life events (T1)",
      neg_LE1 ~ "Recent negative life events (T1)",
      EPDS_T1 ~ "EPDS score (T1)",
      GAD7_T1 ~ "GAD7 score (T1)",
      EPDS_T2 ~ "EPDS score (T2)",
      GAD7_T2 ~ "GAD7 score (T2)",
      bmi ~ "BMI"
    )
  ) %>%

  modify_header(
    stat_1 ~ "**High (≥10)**",
    stat_2 ~ "**Low (<10)**"
  ) %>%
  modify_spanning_header(update = all_stat_cols() ~ "**EPDS score**") %>% 

  add_overall() %>%
  bold_labels() %>%
  italicize_levels()


t2_epds <- table_1_T2 %>%
  dplyr::select(-pid, -GAD_high_T2) %>%
  tbl_summary(
    by = EPDS_high_T2,
    missing = "ifany",
    missing_text = "Missing",
    sort = all_categorical() ~ "frequency",
    type = c(gest_week_T2, EPDS_T2, GAD7_T2) ~ "continuous",
    statistic = all_continuous() ~ "{mean} ({sd})",
    digits = all_categorical() ~ 1,
      label =  list(gest_week_T2 ~ "Gestational week (T2)", 
pos_LE2 ~ "Recent positive life events (T2)",
neg_LE2 ~ "Recent negative life events (T2)",
Anemia_T2 ~ "Self reported anemia (T2)", EPDS_T2 ~ "EPDS score (T2)",
      GAD7_T2 ~ "GAD7 score (T2)")) %>%
  add_overall() %>% 
  bold_labels() %>% 
  italicize_levels()

t_epds <- tbl_stack(list(t1_epds, t2_epds), group_header = c("T1", "T2"))

t1_gad <- table_1_T1 %>%
  dplyr::select(-pid, -EPDS_high_T1) %>%

  tbl_summary(
    by = GAD_high_T1,
    type = c(gest_week_T1, bmi, EPDS_T1, EPDS_T2, GAD7_T1, GAD7_T2, age) ~ "continuous",
    sort = all_categorical() ~ "frequency",
    missing = "ifany",
    missing_text = "Missing",
    statistic = all_continuous() ~ "{mean} ({sd})",
    digits = all_categorical() ~ 1,
    label = list(
      relationship_status_T1 ~ "In a relationship",
      exercise_T1 ~ "Exercise level",
      anemia_T1 ~ "Self-reported anemia (T1)",
      country ~ "Country of birth",
      age ~ "Maternal age",
      gest_week_T1 ~ "Gestational week (T1)",
      education ~ "Educational attainment",
      pos_LE1 ~ "Recent positive life events (T1)",
      neg_LE1 ~ "Recent negative life events (T1)",
      EPDS_T1 ~ "EPDS score (T1)",
      GAD7_T1 ~ "GAD7 score (T1)",
      EPDS_T2 ~ "EPDS score (T2)",
      GAD7_T2 ~ "GAD7 score (T2)",
      bmi ~ "BMI"
    )
  ) %>%

  modify_header(
    stat_1 ~ "**High (≥7)**",
    stat_2 ~ "**Low (<7)**"
  ) %>%
  modify_spanning_header(update = all_stat_cols() ~ "**GAD7 score**") %>% 
  bold_labels() %>%
  italicize_levels() 



t2_gad <- table_1_T2 %>%
  dplyr::select(-pid, -EPDS_high_T2) %>%
  tbl_summary(
    by = GAD_high_T2,
    missing = "ifany",
    missing_text = "Missing",
    sort = all_categorical() ~ "frequency",
    type = c(gest_week_T2, EPDS_T2, GAD7_T2) ~ "continuous",
    statistic = all_continuous() ~ "{mean} ({sd})",
    digits = all_categorical() ~ 1,
      label =  list(gest_week_T2 ~ "Gestational week (T2)", 
pos_LE2 ~ "Recent positive life events (T2)",
neg_LE2 ~ "Recent negative life events (T2)",
Anemia_T2 ~ "Self-reported anemia (T2)", EPDS_T2 ~ "EPDS score (T2)",
      GAD7_T2 ~ "GAD7 score (T2)"))%>%
  bold_labels() %>% 
  italicize_levels() 

t1_table <- tbl_merge(list(t1_epds, t1_gad), tab_spanner = c("**EPDS score**", "**GAD7 score**"))
t2_table <- tbl_merge(list(t2_epds, t2_gad))

full_table <- tbl_stack(list(t1_table, t2_table), group_header = c("T1", "T2"))


full_table %>%
  as_gt()

full_table %>%
  as_flex_table() %>%
  autofit() %>%             
  flextable::save_as_docx(path = "table1.docx")


